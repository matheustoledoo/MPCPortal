# ---------------------------------------------------------------------------
# PortalMPC — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ---------------------------------------------------------------------------

# Públicas (podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publishable_ou_anon

# URL usada nos e-mails de recuperação de senha
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor / scripts. JAMAIS use no navegador nem com prefixo NEXT_PUBLIC_.
# Necessária para `npm run import:planilhas` e `npm run seed:usuarios`.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# ---------------------------------------------------------------------------
# Rede corporativa com inspeção de TLS (proxy da empresa)
# ---------------------------------------------------------------------------
# O navegador confia no certificado da empresa porque ele está no Windows,
# mas o Node.js usa a própria lista de autoridades e recusa a conexão —
# o sintoma é "AuthRetryableFetchError: fetch failed" no terminal.
#
# Node 22+ resolve usando os certificados do sistema operacional:
#   PowerShell:  $env:NODE_OPTIONS="--use-system-ca"; npm run start
#   CMD:         set NODE_OPTIONS=--use-system-ca && npm run start
#   bash:        NODE_OPTIONS=--use-system-ca npm run start
#
# Alternativa, apontando o certificado raiz exportado da empresa:
#   $env:NODE_EXTRA_CA_CERTS="C:\caminho\ca-empresa.cer"
