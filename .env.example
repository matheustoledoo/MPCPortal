# ---------------------------------------------------------------------------
# PortalMPC — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ---------------------------------------------------------------------------

# Públicas (podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publishable_ou_anon

# URL usada nos e-mails de recuperação de senha
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor / scripts. JAMAIS use no navegador nem com prefixo NEXT_PUBLIC_.
# Necessária para `npm run import:planilhas` e `npm run seed:usuarios`.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
